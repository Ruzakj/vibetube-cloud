{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"},
        {"key":"Cross-Origin-Opener-Policy","value":"same-origin-allow-popups"}
      ]
    },
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-store, no-cache, must-revalidate"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store, no-cache, must-revalidate"}]},
    {"source":"/script.js","headers":[{"key":"Cache-Control","value":"no-store, no-cache, must-revalidate"}]},
    {"source":"/cloud-config.js","headers":[{"key":"Cache-Control","value":"no-store, no-cache, must-revalidate"}]}
  ]
}
